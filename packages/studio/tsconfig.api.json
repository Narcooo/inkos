{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/api/**/*.ts", "src/shared/**/*.ts"]
}
